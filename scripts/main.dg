extends Node3D

func _ready():
    print("КОМНАТА 404")
    print("Ты проснулся в неизвестном месте...")
    print("Найди выход. Но не доверяй всему, что видишь.")

    create_room()


func create_box(object_name, size, pos, color):
    var obj = MeshInstance3D.new()
    var mesh = BoxMesh.new()

    mesh.size = size
    obj.mesh = mesh
    obj.position = pos
    obj.name = object_name

    var material = StandardMaterial3D.new()
    material.albedo_color = color
    obj.material_override = material

    add_child(obj)


func create_room():
    # Пол
    create_box("Floor", Vector3(8, 0.2, 8),
        Vector3(0, -0.1, 0), Color(0.16, 0.16, 0.17))

    # Потолок
    create_box("Ceiling", Vector3(8, 0.2, 8),
        Vector3(0, 3, 0), Color(0.12, 0.12, 0.13))

    # Задняя и передняя стены
    create_box("BackWall", Vector3(8, 3, 0.2),
        Vector3(0, 1.4, -4), Color(0.35, 0.34, 0.31))

    create_box("FrontWall", Vector3(8, 3, 0.2),
        Vector3(0, 1.4, 4), Color(0.35, 0.34, 0.31))

    # Боковые стены
    create_box("LeftWall", Vector3(0.2, 3, 8),
        Vector3(-4, 1.4, 0), Color(0.29, 0.28, 0.26))

    create_box("RightWall", Vector3(0.2, 3, 8),
        Vector3(4, 1.4, 0), Color(0.29, 0.28, 0.26))

    # Дверь
    create_box("Door", Vector3(1.2, 2.2, 0.08),
        Vector3(0, 1.1, -3.88), Color(0.12, 0.075, 0.05))
